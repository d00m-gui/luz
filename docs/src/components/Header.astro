---
const { breadcrumb } = Astro.props;
---

<div class="main-location">
  <div class="inner-location">
    <nav class="breadcrumbs">
      <ol>
        <li><a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/`}>Inicio</a></li>
        <li>{breadcrumb}</li>
      </ol>
    </nav>
  </div>
</div>
