---
import { getCollection } from "astro:content";
import {
  CATEGORY_HUES,
  COMPONENT_CATEGORY_HUES,
  DEFAULT_CATEGORY_HUE,
} from "../lib/category-colors";
import { loadComponents } from "../content/components";

import LuzLogo from "./LuzLogo.astro";

interface Props {
  activeId: string;
  title: string;
  hue: string;
}

const { activeId, title, hue } = Astro.props;
const features = (await getCollection("features")).sort(
  (a, b) => a.data.order - b.data.order,
);
const { visibleComponents } = await loadComponents();
const componentsByCategory = Object.groupBy(
  visibleComponents,
  (c) => c.category,
);
---

<nav class="sidebar drawer-sidebar">
  <div class="sidebar-scroll scrollbar-thin">
    <div class="main-title">
      <figure class="logo">
        <LuzLogo color={`var(--${hue}-500)`} />
      </figure>
      <h5 class="component-name" style={`color: var(--${hue}-200)`}>{title}</h5>
    </div>
    <div class="list">
      <a
        href="/"
        class="list-row"
        aria-current={activeId === "luz-defaults" ? "page" : undefined}
        style={`--sidebar-bg: var(--primary-400)`}
      >
        Inicio
      </a>

      {
        Object.entries(componentsByCategory).map(([category, entries]) => {
          const isOpen = entries!.some((c) => activeId === `component-${c.id}`);
          return (
            <details class="list-row" open={isOpen}>
              <summary>{category}</summary>
              <div class="list">
                {entries!.map((c) => {
                  const hue =
                    COMPONENT_CATEGORY_HUES[c.category] ?? DEFAULT_CATEGORY_HUE;
                  return (
                    <a
                      href={`/components/${c.id}`}
                      class="list-row"
                      aria-current={
                        activeId === `component-${c.id}` ? "page" : undefined
                      }
                      style={`--sidebar-bg: var(--${hue}-400)`}
                    >
                      <span
                        class="sidebar-dot"
                        style={`background: var(--${hue}-400)`}
                      />
                      {c.title}
                    </a>
                  );
                })}
              </div>
            </details>
          );
        })
      }
      {
        features.length > 0 && (
          <details
            class="list-row"
            open={features.some((f) => activeId === `api-${f.id}`)}
          >
            <summary>API</summary>
            <div class="list">
              {features.map((entry) => {
                const hue = CATEGORY_HUES[entry.id] ?? DEFAULT_CATEGORY_HUE;
                return (
                  <a
                    href={`/api/${entry.id}`}
                    class="list-row"
                    aria-current={
                      activeId === `api-${entry.id}` ? "page" : undefined
                    }
                    style={`--sidebar-bg: var(--${hue}-400)`}
                  >
                    <span
                      class="sidebar-dot"
                      style={`background: var(--${hue}-400)`}
                    />
                    {entry.data.title}
                  </a>
                );
              })}
            </div>
          </details>
        )
      }
    </div>
  </div>
</nav>
