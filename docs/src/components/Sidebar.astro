---
import { getCollection } from "astro:content";

interface Props {
  activeId: string;
}

const { activeId } = Astro.props;
const all = await getCollection("components");

const order = ["Components", "Hooks", "Config", "Astro"] as const;
const grouped = order.map((category) => ({
  category,
  items: all
    .filter((e) => e.data.category === category)
    .sort((a, b) => a.data.title.localeCompare(b.data.title)),
}));
---

<nav class="sidebar">
  {
    grouped.map(({ category, items }) =>
      items.length ? (
        <div class="sidebar-group">
          <div class="sidebar-group-title">{category}</div>
          {items.map((item) => (
            <a
              href={`/${item.id}/`}
              class={`sidebar-item${item.id === activeId ? " active" : ""}`}
            >
              {item.data.title}
            </a>
          ))}
        </div>
      ) : null,
    )
  }
</nav>
