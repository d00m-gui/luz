---
interface Props {
  activeId: string;
}

const { activeId } = Astro.props;
---

<nav class="sidebar">
  <div class="sidebar-group">
    <div class="sidebar-group-title">Docs</div>
    <a
      href="/"
      class={`sidebar-item${activeId === "classless" ? " active" : ""}`}
    >
      Luz
    </a>
  </div>
</nav>
