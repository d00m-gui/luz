---
import { readFileSync } from "node:fs";
import { gzipSync } from "node:zlib";
import LuzLogo from "./LuzLogo.astro";
import { GamutLegend } from "./GamutLegend";
import pkg from "../../../package.json" with { type: "json" };

let version = pkg.version;
try {
  if (typeof Bun !== "undefined" && !Bun.semver.satisfies(version, "*")) {
    version = "0.0.0";
  }
} catch {}

let cssWeight = "loading";
try {
  const css = readFileSync(new URL("../styles/luz.css", import.meta.url));
  cssWeight = `${(gzipSync(css).length / 1024).toFixed(1)}KB`;
} catch {}
---

<div class="main-statusbar panel-header bottom">
  <figure class="small-logo">
    <LuzLogo color={`var(--primary)`} />
  </figure>
  <GamutLegend client:load />
  <div class="palette">
    <span class="status" style={`color: var(--red-400)`}></span>
    <span class="status" style={`color: var(--green-400)`}></span>
    <span class="status" style={`color: var(--blue-400)`}></span>
  </div>
  <div class="space"></div>
  <span title="luz.css, gzip"
    >{cssWeight === "loading" ? <span aria-busy="true" /> : cssWeight}</span
  >
  <span id="perf-stat" title="first contentful paint / tiempo de transición"
    ><span aria-busy="true"></span> fcp</span
  >
  <span>v{version}</span>
  <button
    popovertarget="sidebar-drawer"
    class="sidebar-drawer-trigger grow-0 btn ghost icon"
    aria-label="Alternar sidebar"
  >
    <i class="nf nf-cod-list_selection"></i>
  </button>
</div>

<style>
  .palette {
    display: flex;
    gap: var(--space-1);
  }
  .sidebar-drawer-trigger {
    @media (min-width: 48rem) {
      display: none;
    }
  }
</style>

<script>
  let navStart = 0;
  document.addEventListener("astro:before-preparation", () => {
    navStart = performance.now();
  });
  document.addEventListener("astro:page-load", () => {
    const el = document.getElementById("perf-stat");
    if (!el) return;
    if (!navStart) {
      const report = () => {
        const fcp = performance
          .getEntriesByType("paint")
          .find((entry) => entry.name === "first-contentful-paint");
        if (fcp) el.textContent = `${Math.round(fcp.startTime)}ms fcp`;
      };
      new PerformanceObserver((list, observer) => {
        if (list.getEntriesByName("first-contentful-paint").length) {
          report();
          observer.disconnect();
        }
      }).observe({ type: "paint", buffered: true });
      report();
    } else {
      el.textContent = `${Math.round(performance.now() - navStart)}ms nav`;
    }
  });
</script>
