---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import Sidebar from "../components/Sidebar.astro";
import Header from "../components/Header.astro";
import { CrtIntroMount } from "../components/CrtIntroMount";
import { DEFAULT_CATEGORY_HUE } from "../lib/category-colors";
import "../styles/luz.css";
import "../styles/structure.css";
import "../styles/nerd-icons.generated.css";

interface Props {
  title: string;
  activeId: string;
  breadcrumb: string;
  contentClass?: string;
  hue?: string;
}

const {
  title,
  activeId,
  breadcrumb,
  contentClass,
  hue = DEFAULT_CATEGORY_HUE,
} = Astro.props;
---

<html lang="en" data-theme="dark" data-hue={hue}>
  <head>
    <meta charset="utf-8" />
    <title>{title} — luz docs</title>
    <Font cssVariable="--dm-sans" />
    <Font cssVariable="--dm-mono" />
    <Font cssVariable="--eb-serif" />
    <ClientRouter />
  </head>
  <body>
    <div class="layout">
      <Header breadcrumb={breadcrumb} />
      <div class="container main-row">
        <input
          type="checkbox"
          id="sidebar-drawer"
          class="drawer-toggle"
          checked
          hidden
        />
        <Sidebar activeId={activeId} />
        <main class="main">
          <div class:list={["content", contentClass]}>
            <slot />
            <!-- <CrtIntroMount client:load transition:persist /> -->
          </div>
        </main>
      </div>
      <div class="main-statusbar panel-header bottom">
        <span>All systems nominal</span>
        <div class="space"></div>
        <span>palette</span>
        <span>size</span>
        <span>performance</span>
        <span>luz v0.1.0</span>
      </div>
    </div>
  </body>
</html>

<script>
  let savedSidebarScroll = 0;

  document.addEventListener("astro:before-swap", () => {
    savedSidebarScroll = document.querySelector(".sidebar")?.scrollTop ?? 0;
  });
  document.addEventListener("astro:after-swap", () => {
    const sidebar = document.querySelector(".sidebar");
    if (sidebar) sidebar.scrollTop = savedSidebarScroll;
  });

  document.addEventListener("click", async (event) => {
    const btn = (event.target as HTMLElement).closest<HTMLButtonElement>(
      "[data-copy]",
    );
    if (!btn) return;
    const code = btn.nextElementSibling?.textContent ?? "";
    const original = btn.textContent;
    try {
      await navigator.clipboard.writeText(code);
      btn.textContent = "Copied";
    } catch {
      btn.textContent = "Error";
    }
    setTimeout(() => {
      btn.textContent = original;
    }, 1500);
  });
</script>
