---
import Layout from "../../layouts/Layout.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import { loadComponents } from "../../content/components";
import {
  COMPONENT_CATEGORY_HUES,
  DEFAULT_CATEGORY_HUE,
} from "../../lib/category-colors";

export async function getStaticPaths() {
  const { visibleComponents } = await loadComponents();
  return visibleComponents.map((c) => ({
    params: { id: c.id },
    props: { component: c },
  }));
}

const { component } = Astro.props;
const hue = COMPONENT_CATEGORY_HUES[component.category] ?? DEFAULT_CATEGORY_HUE;
---

<Layout
  title={component.title}
  activeId={`component-${component.id}`}
  breadcrumb={component.title}
  hue={hue}
>
  <!-- <h2 style={`color: var(--${hue}-500)`}>
    {component.title}
  </h2> -->
  {component.desc && <p set:html={` — ${component.desc}`} />}
  <div class="docs-sections">
    <article class="component-doc">
      <div class={`component-preview elevate ${component.id}-preview`}>
        <Fragment set:html={component.preview ?? component.html} />
      </div>
      <CodeBlock code={component.html} />
    </article>
    {
      component.variants?.map((variant) => (
        <article class="component-doc">
          <h3 class="component-doc-title">{variant.title}</h3>
          {variant.desc && <p set:html={` — ${variant.desc}`} />}
          <div
            class={`component-preview elevate ${component.id}-variant-preview`}
          >
            <Fragment set:html={variant.preview ?? variant.html} />
          </div>
          <CodeBlock code={variant.html} />
        </article>
      ))
    }
  </div>
</Layout>
