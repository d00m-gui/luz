---
import Layout from "../../layouts/Layout.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import { COMPONENTS } from "../../content/components";
import { COMPONENT_CATEGORY_HUES, DEFAULT_CATEGORY_HUE } from "../../lib/category-colors";

export function getStaticPaths() {
  return COMPONENTS.map((c) => ({ params: { id: c.id }, props: { component: c } }));
}

const { component } = Astro.props;
const hue = COMPONENT_CATEGORY_HUES[component.category] ?? DEFAULT_CATEGORY_HUE;
---

<Layout
  title={component.title}
  activeId={`component-${component.id}`}
  breadcrumb={component.title}
  hue={hue}
>
  <h2 style={`color: var(--${hue}-500)`}>{component.title}</h2>
  <div class="docs-sections">
    <section class="card">
      <article class="component-doc">
        <div class="component-preview">
          <Fragment set:html={component.preview ?? component.html} />
        </div>
        <CodeBlock code={component.html} />
      </article>
    </section>
  </div>
</Layout>
