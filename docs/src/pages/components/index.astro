---
import Layout from "../../layouts/Layout.astro";
import { ThemeToolbar } from "../../components/ThemeToolbar";
import { COMPONENTS } from "../../content/components";
import { COMPONENT_CATEGORY_HUES, DEFAULT_CATEGORY_HUE } from "../../lib/category-colors";
---

<Layout title="Componentes" activeId="components-index" breadcrumb="Componentes">
  <h2>Componentes</h2>
  <section class="card components-toolbar-card">
    <div class="titlebar panel-header">
      <span class="panel-header-title">Tema en vivo</span>
    </div>
    <ThemeToolbar client:load />
  </section>
  <div class="components-index-grid">
    {
      COMPONENTS.map((component) => {
        const hue = COMPONENT_CATEGORY_HUES[component.category] ?? DEFAULT_CATEGORY_HUE;
        return (
          <article class="card components-index-item lazy-render">
            <a href={`/components/${component.id}`} style={`color: var(--${hue}-500)`}>
              {component.title}
            </a>
            <div class="component-preview">
              <Fragment set:html={component.preview ?? component.html} />
            </div>
          </article>
        );
      })
    }
  </div>
</Layout>
