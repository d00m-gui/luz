---
import Layout from "../layouts/Layout.astro";
import { luz } from "../../../src/luz";
import { WHEEL_HUE_NAMES } from "../../../src/tools/wheel";
import { config } from "../../luz.config.ts";
import { UNCOVERED_FILES } from "../content/components";

const { tokens } = luz(config);

if (UNCOVERED_FILES.length > 0) {
  console.warn(
    `[components] componentes sin ejemplo en components.ts: ${UNCOVERED_FILES.join(", ")}`,
  );
}

const WEIGHTS = [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950];
const SHADE_SCALES = ["primary", "secondary", "neutral"];
const WHEEL_HUES = WHEEL_HUE_NAMES;

const TEXT_SCALE_NAMES = ["xs", "sm", "base", "lg", "xl", "2xl", "3xl"];

function swatchStyle(name: string, weight: number) {
  return `background: var(--${name}-${weight})`;
}
---

<Layout
  title="Luz"
  activeId="luz-defaults"
  breadcrumb="Tokens"
  contentClass="luz-defaults"
>
  <h2>Tokens</h2>
  <div class="docs-sections">
    <section class="card">
      {
        SHADE_SCALES.map((name) => (
          <div class="swatch-row">
            <div class="swatch-row-label">{name}</div>
            <div class="swatch-list">
              {WEIGHTS.map((weight) => (
                <div class="swatch" data-name={name} style={swatchStyle(name, weight)}>
                  <span>{weight}</span>
                </div>
              ))}
            </div>
          </div>
        ))
      }

      {
        WHEEL_HUES.map((name) => (
          <div class="swatch-row">
            <div class="swatch-row-label">{name}</div>
            <div class="swatch-list">
              {WEIGHTS.map((weight) => (
                <div class="swatch" data-name={name} style={swatchStyle(name, weight)}>
                  <span>{weight}</span>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </section>

    <section class="card">
      <h2 class="card-title">Sizes</h2>

      <div class="text-scale">
        {
          TEXT_SCALE_NAMES.map((name) => (
            <div class="text-scale-step">
              <span style={`font-size: var(--font-size-${name})`}>Aa</span>
              <code>--font-size-{name}</code>
            </div>
          ))
        }
      </div>

      <div class="size-scale">
        {
          ["border-radius", "border-width", "spacing"].map((name) => (
            <div class="size-step">
              <div
                class="size-swatch size-swatch-flat"
                style={`width: var(--${name}); height: calc(var(--size-unit) * 6)`}
              />
              <code>--{name}</code>
            </div>
          ))
        }
      </div>
    </section>

    <section class="card">
      <h2 class="card-title">Typography</h2>
      <div class="html fluid">
        <h1>Un sistema de diseño que vive en tu CSS</h1>
        <p>
          luz genera colores, tipografía y espaciado a partir de un solo color <strong
            >primary</strong
          > — sin build step propio, sin runtime: el resultado es CSS plano que corre
          en cualquier framework, o en ninguno.
        </p>
        <div class="kitchen-sink-row">
          <button>Empezar</button>
          <a href="/components/button" class="ghost">Ver componentes</a>
        </div>

        <hr />

        <h1>Make it easy to read</h1>
        <h2>Make it easy to read</h2>
        <h3>Make it easy to read</h3>
        <h4>Make it easy to read</h4>
        <h5>Make it easy to read</h5>
        <h6>Make it easy to read</h6>

        <h3>Un color, una paleta completa</h3>
        <p>
          Cada paleta nace de una <a href="#" class="secondary"
            >rueda armonizada</a
          > de doce hues, pensada para que el contraste funcione en modo{" "}
          <em>claro</em> y <em>oscuro</em> sin retocar nada a mano. El resultado:
          componentes coherentes entre sí incluso cuando cambiás el color base.
        </p>
        <h3>La config siempre gana</h3>
        <p>
          La regla que gobierna todo el proyecto es simple:{" "}
          <mark>cualquier valor que luz calcule puede overridearse</mark>,
          aplicado al final del pipeline, sin pisadas de cálculos internos
          posteriores. Si un <a href="#" class="danger">rojo</a> queda muy saturado
          o un <a href="#" class="success">verde</a> poco legible, se ajusta en la
          config — no en el CSS generado.
        </p>
        <blockquote>
          "La mejor config es la que no tenés que tocar dos veces."
          <cite>— filosofía de luz</cite>
        </blockquote>
        <p>
          Buscá cualquier token, clase o variable con <kbd>Ctrl</kbd> +{" "}
          <kbd>K</kbd>.
        </p>
        <hr />
        <hr class="dashed" />
      </div>
    </section>
  </div>
</Layout>

<script>
  function resolveRGB(color: string): [number, number, number] {
    const canvas = new OffscreenCanvas(1, 1);
    const ctx = canvas.getContext("2d")!;
    ctx.fillStyle = color;
    ctx.fillRect(0, 0, 1, 1);
    const [r, g, b] = ctx.getImageData(0, 0, 1, 1).data;
    return [r!, g!, b!];
  }

  function contrastSwatches() {
    for (const el of document.querySelectorAll<HTMLElement>(".swatch[data-name]")) {
      const name = el.dataset.name;
      if (!name) continue;
      const [r, g, b] = resolveRGB(getComputedStyle(el).backgroundColor);
      const luminance = (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255;
      el.style.color = `var(--on-${name}${luminance > 0.5 ? "-inverse" : ""})`;
    }
  }
  document.addEventListener("astro:page-load", contrastSwatches);
</script>
