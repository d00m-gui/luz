---
import Layout from "../layouts/Layout.astro";
import { luz } from "../../../src/luz";
import { config } from "../../luz.config.ts";
import { COMPONENTS, UNCOVERED_CLASSES } from "../content/components";

const { tokens } = luz(config);

if (UNCOVERED_CLASSES.length > 0) {
  console.warn(
    `[components] sin ejemplo en components.ts: ${UNCOVERED_CLASSES.join(", ")}`,
  );
}

const COMPONENT_CATEGORIES = ["Overlays", "Feedback", "Navigation", "Layout"] as const;
const CATEGORY_TITLES: Record<(typeof COMPONENT_CATEGORIES)[number], string> = {
  Overlays: "Overlays",
  Feedback: "Feedback",
  Navigation: "Navigation",
  Layout: "Layout & Data",
};

const WEIGHTS = [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950];
const SHADE_SCALES = ["primary", "secondary", "neutral"];
const WHEEL_HUES = [
  "red",
  "orange",
  "copper",
  "yellow",
  "green",
  "emerald",
  "teal",
  "cyan",
  "blue",
  "sky",
];

const TEXT_SCALE_NAMES = ["xs", "sm", "base", "lg", "xl", "2xl", "3xl"];

function swatchStyle(name: string, weight: number) {
  const raw = tokens.colors[`${name}-${weight}`];
  const lightnessMatch = raw?.match(/oklch\(from \S+ ([\d.]+)%/);
  const lightness = lightnessMatch
    ? Number(lightnessMatch[1])
    : weight <= 400
      ? 80
      : 20;
  const onColor = lightness >= 50 ? `on-${name}-inverse` : `on-${name}`;
  return `background: var(--${name}-${weight}); color: var(--${onColor})`;
}
---

<Layout
  title="Luz"
  activeId="luz-defaults"
  breadcrumb="Tokens"
  contentClass="luz-defaults"
>
  <h2>Tokens</h2>
  <div class="docs-sections">
    <section class="card">
      {
        SHADE_SCALES.map((name) => (
          <div class="swatch-row">
            <div class="swatch-row-label">{name}</div>
            <div class="swatch-list">
              {WEIGHTS.map((weight) => (
                <div class="swatch" style={swatchStyle(name, weight)}>
                  <span>{weight}</span>
                </div>
              ))}
            </div>
          </div>
        ))
      }

      {
        WHEEL_HUES.map((name) => (
          <div class="swatch-row">
            <div class="swatch-row-label">{name}</div>
            <div class="swatch-list">
              {WEIGHTS.map((weight) => (
                <div class="swatch" style={swatchStyle(name, weight)}>
                  <span>{weight}</span>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </section>

    <section class="card">
      <h2 class="card-title">Sizes</h2>

      <div class="text-scale">
        {
          TEXT_SCALE_NAMES.map((name) => (
            <div class="text-scale-step">
              <span style={`font-size: var(--font-size-${name})`}>Aa</span>
              <code>--font-size-{name}</code>
            </div>
          ))
        }
      </div>

      <div class="size-scale">
        {
          ["border-radius", "border-width", "spacing"].map((name) => (
            <div class="size-step">
              <div
                class="size-swatch size-swatch-flat"
                style={`width: var(--${name}); height: calc(var(--size-unit) * 6)`}
              />
              <code>--{name}</code>
            </div>
          ))
        }
      </div>
    </section>

    <section class="card">
      <h2 class="card-title">Typography</h2>
      <div class="html fluid">
        <h1>Un sistema de diseño que vive en tu CSS</h1>
        <p>
          luz genera colores, tipografía y espaciado a partir de un solo
          color <strong>primary</strong> — sin build step propio, sin
          runtime: el resultado es CSS plano que corre en cualquier
          framework, o en ninguno.
        </p>
        <div class="kitchen-sink-row">
          <button>Empezar</button>
          <button class="ghost">Ver componentes</button>
        </div>

        <hr />

        <h1>Make it easy to read</h1>
        <h2>Make it easy to read</h2>
        <h3>Make it easy to read</h3>
        <h4>Make it easy to read</h4>
        <h5>Make it easy to read</h5>
        <h6>Make it easy to read</h6>

        <h3>Un color, una paleta completa</h3>
        <p>
          Cada paleta nace de una <a href="#" class="secondary"
            >rueda armonizada</a
          > de diez hues, pensada para que el contraste funcione en modo{" "}
          <em>claro</em> y <em>oscuro</em> sin retocar nada a mano. El resultado:
          componentes coherentes entre sí incluso cuando cambiás el color base.
        </p>
        <h3>La config siempre gana</h3>
        <p>
          La regla que gobierna todo el proyecto es simple:{" "}
          <mark>cualquier valor que luz calcule puede overridearse</mark>,
          aplicado al final del pipeline, sin pisadas de cálculos internos
          posteriores. Si un <a href="#" class="danger">rojo</a> queda muy
          saturado o un <a href="#" class="success">verde</a> poco legible,
          se ajusta en la config — no en el CSS generado.
        </p>
        <blockquote>
          "La mejor config es la que no tenés que tocar dos veces."
          <cite>— filosofía de luz</cite>
        </blockquote>
        <p>
          Buscá cualquier token, clase o variable con <kbd>Ctrl</kbd> +{" "}
          <kbd>K</kbd>.
        </p>
        <hr />
        <hr class="dashed" />
      </div>
    </section>

    <section class="card">
      <h2 class="card-title">Buttons</h2>
      <div role="group" class="kitchen-sink-row">
        <button>Default</button>
        <button class="success">Success</button>
        <button class="contrast">Contrast</button>
        <button class="danger">Danger</button>
        <button class="warning">Warning</button>
        <button class="ghost">Ghost</button>
        <button class="reset">Reset</button>
        <button class="pill">Pill</button>
        <button disabled>Disabled</button>
      </div>
    </section>

    <section class="card">
      <h2 class="card-title">Form</h2>
      <form class="kitchen-sink-form">
        <label>
          Text input
          <input type="text" placeholder="Type here" />
        </label>
        <label>
          Valid input
          <input type="text" aria-invalid="false" value="Looks good" />
        </label>
        <label>
          Invalid input
          <input type="text" aria-invalid="true" value="Something's off" />
        </label>
        <label>
          Textarea
          <textarea placeholder="Type something..."></textarea>
        </label>

        <label>
          Range
          <input type="range" />
        </label>
        <label><input type="checkbox" checked /> Checkbox</label>
        <label><input type="checkbox" role="switch" checked /> Switch</label>
        <label><input type="radio" name="ks-radio" checked /> Radio A</label>
        <label><input type="radio" name="ks-radio" /> Radio B</label>
        <label>
          File
          <input type="file" />
        </label>
        <label>
          Progress
          <progress value="60" max="100"></progress>
        </label>
      </form>
    </section>

    <section class="card">
      <h2 class="card-title">Table</h2>
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Role</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Ada</td>
            <td>Admin</td>
            <td>Active</td>
          </tr>
          <tr>
            <td>Grace</td>
            <td>Editor</td>
            <td>Pending</td>
          </tr>
        </tbody>
      </table>
    </section>

    {
      COMPONENT_CATEGORIES.map((category) => (
        <section class="card">
          <h2 class="card-title">{CATEGORY_TITLES[category]}</h2>
          {COMPONENTS.filter((c) => c.category === category).map((c) => (
            <article class="component-doc">
              <h3 class="component-doc-title">{c.title}</h3>
              <div class="component-preview">
                <Fragment set:html={c.preview ?? c.html} />
              </div>
              <div class="component-code">
                <button class="copy-btn ghost" data-copy type="button">
                  Copy
                </button>
                <pre><code>{c.html}</code></pre>
              </div>
            </article>
          ))}
        </section>
      ))
    }
  </div>
</Layout>

<script>
  document.addEventListener("click", async (event) => {
    const btn = (event.target as HTMLElement).closest<HTMLButtonElement>(
      "[data-copy]",
    );
    if (!btn) return;
    const code = btn.nextElementSibling?.textContent ?? "";
    const original = btn.textContent;
    try {
      await navigator.clipboard.writeText(code);
      btn.textContent = "Copied";
    } catch {
      btn.textContent = "Error";
    }
    setTimeout(() => {
      btn.textContent = original;
    }, 1500);
  });
</script>
