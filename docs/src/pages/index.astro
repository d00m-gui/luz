---
import Layout from "../layouts/Layout.astro";
const SURFACE_VARIANTS = ["primary", "secondary", "neutral", "tertiary"];
---

<Layout
  title="Summary"
  activeId="styleguide"
  breadcrumb="Summary"
  contentClass="styleguide"
>
  <div class="styleguide element row">
    <div class="element">
      <div class="main-logo card">
        <div class="hero primary solid">
          <div class="hero-content">
            <img src="/luz-logo-rgb.svg" alt="luz" />
          </div>
        </div>
      </div>
      <div class="aplications element row">
        <div class="invert-logo card">
          <figure class="card-feature">
            <img src="/luz-logo-rgb.svg" alt="luz" />
          </figure>
        </div>
        <div class="applied-logo card">
          <div class="component-preview">
            <button style="scale: 2">Button</button>
          </div>
        </div>
      </div>
    </div>
    <div class="main-matrix card">
      <div class="palette-stack">
        {
          SURFACE_VARIANTS.map((variant) => (
            <span class={`palette-dot ${variant}`} />
          ))
        }
      </div>
    </div>
  </div>
  <div class="grid demo-grid">
    <div class="demo-copytext card">
      <div class="demo-content">
        <span class="badge neutral">Header</span>
        <h4>Design.</h4>
        <span class="badge neutral">Body</span>
        <p>
          The technique of merging between innocence and experience of graphic
          ideas, and turn them into visually appealing communication.
        </p>
      </div>
      <div class="card-footer"></div>
    </div>
    <div class="demo-ui card">
      <div class="phone card">
        <div class="phone-bar">
          <img src="/luz-logo-rgb.svg" alt="luz" />
          <p><i class="icon nf nf-cod-menu"></i></p>
        </div>
        <div class="phone-content">
          <h3>Layout.</h3>
          <p>
            Visual elements Layout, Typography, Colors, Sizes, Images, Shapes
            and Space
          </p>
          <hr class="dashed" />
        </div>
      </div>
    </div>

    <div class="demo-buttons card">
      <div class="component-preview">
        <div class="join">
          <input type="text" placeholder="Search..." />
          <button><i class="icon nf nf-seti-search"></i></button>
        </div>
        <div class="card">
          <div class="card-content" style="flex-direction: column;">
            <div class="skeleton" style="height: 4rem; width: 100%;"></div>
            <div class="skeleton" style="height: 0.75rem; width: 80%;"></div>
            <div class="skeleton" style="height: 0.75rem; width: 60%;"></div>
          </div>
        </div>
        <div class="demo-buttons-nav">
          <button type="button" class="pill neutral" aria-label="Anterior">
            <i class="icon nf nf-cod-arrow_left"></i>
          </button>
          <button type="button" class="pill neutral" aria-label="Siguiente">
            <i class="icon nf nf-cod-arrow_right"></i>
          </button>
        </div>
      </div>
    </div>
    <div class="demo-surface card">
      <div class="card-meta">Typography</div>
      <div class="card-content">
        <h1 class="head">Aa</h1>
        <h5 class="upper">ABCDFGHIJKLMNOPQRSTUVWXYZ</h5>
        <h5 class="lower">abcdfghijklmnopqrstuvwxyz</h5>
        <h5 class="number">1234567890</h5>
      </div>
      <div class="card-meta"></div>
    </div>
  </div>
</Layout>

<style>
  .styleguide {
    align-items: stretch;
    gap: var(--space-4);
    min-height: 40vh;
    .element {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      flex: 2 1 0;
    }
    .main-logo {
      flex: 1.3 1 0;
      .hero {
        height: 100%;
        align-items: center;
        justify-content: center;
      }
      .hero-content {
        align-items: center;
      }
      img {
        width: 12rem;
        filter: brightness(0) invert(1);
      }
    }
    .aplications {
      flex: 1 1 0;
      gap: var(--space-4);
      flex-direction: row;
      flex-wrap: wrap;
      > * {
        flex: 1 1 0;
      }
    }
    .invert-logo {
      background-color: var(--neutral-800);
      filter: invert(100%) grayscale(100%);
      flex: 0 0 auto;
      max-width: 15rem;
    }
    .invert-logo .card-feature {
      height: 100%;
      align-items: center;
      justify-content: center;
      img {
        width: 8rem;
      }
    }
    .applied-logo .card-feature {
      height: 100%;
      background-size: cover;
      background-position: center;
      align-items: flex-end;
      justify-content: center;
      padding: var(--space-4);
    }
    .main-matrix {
      flex: 0 0 auto;
      align-items: center;
      justify-content: center;
    }
    .component-preview {
      display: grid;
      align-items: center;
      align-content: center;
      justify-content: center;
      gap: var(--space-2);
      button {
        width: fit-content;
        margin: 0 auto;
      }
    }
  }
  .demo-ui {
    padding: var(--space-8) var(--space-3) 0;
    position: relative;
    background-image: linear-gradient(
      145deg,
      var(--primary-500),
      var(--primary-800)
    );
    border: none;
    .phone {
      position: absolute;
      left: var(--space-3);
      right: var(--space-3);
      bottom: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      border-radius: 0.5rem 0.5rem 0 0;
      border-bottom: none;
      box-shadow: 0 -10px 6px -10px var(--neutral-950);
      .phone-bar {
        padding: var(--element-vertical) calc(var(--element-horizontal) * 1.75);
        border-bottom: var(--border-width) solid var(--element-border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
        img {
          height: var(--space-4);
        }
      }
      .phone-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        padding: var(--element-vertical) calc(var(--element-horizontal) * 1.75);
      }
    }
  }
  .card-feature {
    display: flex;
  }
  .palette-stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1 1 auto;
  }
  .palette-dot {
    width: 15rem;
    flex: 1 1 auto;
    background-color: var(--scheme);
    border: var(--border-width) solid var(--element-border-color);
    &:first-child {
      margin-block-start: 0;
    }
  }
  .demo-grid {
    --grid-col-size-min: 12rem;
    h3 {
      margin: 0.5rem 0 1rem;
    }
  }
  .demo-buttons {
    .component-preview {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      justify-content: space-between;
      .join {
        width: 100%;
        input {
          width: 100%;
        }
      }
      .demo-buttons-nav {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
      }
    }
  }
  .demo-copytext {
    padding: var(--space-4);
    .badge {
      margin: 1.5rem 0 0.7rem;
    }
  }
  .demo-surface {
    .head {
      font-size: 8cqi;
      color: var(--primary-100);
    }
    .upper {
      color: var(--primary-300);
    }
    .lower {
      color: var(--primary-500);
    }
    .number {
      color: var(--primary-700);
    }
  }
</style>
