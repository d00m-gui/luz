---
import Layout from "../layouts/Layout.astro";

const VARIANTS = [
  "primary",
  "secondary",
  "neutral",
  "info",
  "danger",
  "success",
  "warning",
  "contrast",
];

const SHAPES = ["solid", "soft", "outline"];

const SURFACE_VARIANTS = ["primary", "secondary", "tertiary", "quaternary"];

const ANCHOR_VARIANTS = [
  "secondary",
  "tertiary",
  "quaternary",
  "danger",
  "success",
  "warning",
  "contrast",
];
---

<Layout
  title="Styleguide"
  activeId="styleguide"
  breadcrumb="Styleguide"
  contentClass="styleguide"
>
  <div class="element row">
    <div class="element">
      <div class="card">
        <figure class="card-feature">
          <img src="/luz-logo-rgb.svg" />
        </figure>
      </div>
      <div class="element row">
        <div class="card">
          <figure class="card-feature">
            <img src="/luz-logo-rgb.svg" />
          </figure>
        </div>
        <div class="card">
          <figure class="card-feature">
            <img src="/samples/004-w.png" />
          </figure>
        </div>
      </div>
    </div>
    <div class="card">
      <div id="main-matrix" class="scheme-matrix">
        {
          VARIANTS.map((variant) => (
            <div class="scheme-row">
              <div class={`card ${variant}`}>{variant}</div>
            </div>
          ))
        }
        {
          SURFACE_VARIANTS.map((variant) => (
            <div class="scheme-row">
              <div class={`card surface-${variant}`}>surface-{variant}</div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
  <div class="grid">
    <div class="card">demo ui</div>
    <div class="card">demo copytext</div>
    <div class="card">demo buttons</div>
    <div class="card">demo font</div>
  </div>

  <h1>Styleguide</h1>
  <h2>Esquemas</h2>
  <p>
    Cada variante setea <code>--scheme</code>; cada forma (<code>.solid</code> / <code
      >.soft</code
    > / <code>.outline</code>) decide cómo se pinta con esa variable.
  </p>

  <section class="card">
    <h3 class="card-title">Formas</h3>
    <div class="scheme-matrix">
      {
        VARIANTS.map((variant) => (
          <div class="scheme-row">
            <span class="scheme-row-label">{variant}</span>
            {SHAPES.map((shape) => (
              <span class={`scheme-chip ${shape} ${variant}`}>{shape}</span>
            ))}
          </div>
        ))
      }
    </div>
  </section>

  <section class="card">
    <h3 class="card-title">Componentes</h3>
    <p>
      Mismo <code>--scheme</code>, cada componente decide su propia forma por
      defecto.
    </p>
    <div class="scheme-matrix">
      {
        VARIANTS.map((variant) => (
          <div class="scheme-row">
            <span class="scheme-row-label">{variant}</span>
            <button class={variant}>btn</button>
            <span class={`badge ${variant}`}>badge</span>
            <div class={`alert ${variant}`}>alert</div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="card">
    <h3 class="card-title">anchor-*</h3>
    <p class="scheme-anchors">
      <a href="#">default</a>
      {
        ANCHOR_VARIANTS.map((variant) => (
          <a href="#" class={variant}>
            {variant}
          </a>
        ))
      }
    </p>
  </section>
</Layout>
